    {
      "type": "grammar",
      "kicker": "语法",
      "title": "了①：变化",
      "image": "assets/rain.jpg",
      "image_side": "left",
      "point": "了 ở CUỐI câu = tình huống MỚI / có thay đổi (trước không vậy, giờ vậy).",
      "examples": [
        {
          "hz": "下雨了。",
          "py": "Xià yǔ le.",
          "vn": "Trời mưa rồi."
        },
        {
          "hz": "天气冷了。",
          "py": "Tiānqì lěng le.",
          "vn": "Trời lạnh rồi."
        }
      ],
      "note": "Phủ định thay đổi: 不…了 — 不下雨了 (tạnh mưa rồi).",
      "tip": "了 = '…rồi'. 我十八岁了 = mình 18 tuổi rồi (vừa tròn, trước chưa).",
      "source": "Nguồn: HSK标准教程1, Bài 15",
      "audio": "assets/audio/slide06.mp3"
    },
    {
      "type": "grammar",
      "kicker": "语法",
      "title": "了②：完成",
      "image": "assets/buy.jpg",
      "point": "动词 + 了 = việc ĐÃ HOÀN THÀNH / đã xảy ra.",
      "examples": [
        {
          "hz": "我买了三本书。",
          "py": "Wǒ mǎi le sān běn shū.",
          "vn": "Mình đã mua ba quyển sách."
        },
        {
          "hz": "他去了商店。",
          "py": "Tā qù le shāngdiàn.",
          "vn": "Anh ấy đã đi cửa hàng."
        }
      ],
      "note": "Hỏi: …了吗？ — 你吃饭了吗？(Bạn ăn cơm chưa?)",
      "tip": "Đã làm gì (có kết quả / số lượng cụ thể) → 动词 + 了 + tân ngữ.",
      "source": "Nguồn: HSK标准教程1, Bài 14",
      "audio": "assets/audio/slide07.mp3"
    },
    {
      "type": "grammar",
      "kicker": "语法",
      "title": "没",
      "image": "assets/nopark.jpg",
      "image_side": "left",
      "point": [
        "没(有) + động từ = CHƯA / không (đã) làm.",
        "Đã có 没 thì KHÔNG dùng 了."
      ],
      "examples": [
        {
          "hz": "今天没下雨。",
          "py": "Jīntiān méi xià yǔ.",
          "vn": "Hôm nay trời không mưa."
        },
        {
          "hz": "我没去公园。",
          "py": "Wǒ méi qù gōngyuán.",
          "vn": "Mình chưa đi công viên."
        }
      ],
      "note": "Sai:  我没去了 ❌   →   Đúng:  我没去 ✔",
      "tip": "不 = không (thói quen / tương lai) · 没 = chưa (việc đã qua).",
      "audio": "assets/audio/slide08.mp3"
    },
    {
      "type": "grammar",
      "kicker": "语法",
      "title": "快…了",
      "image": "assets/storm.jpg",
      "point": "快(要) + … + 了 = SẮP xảy ra.",
      "examples": [
        {
          "hz": "快下雨了。",
          "py": "Kuài xià yǔ le.",
          "vn": "Sắp mưa rồi."
        },
        {
          "hz": "快到冬天了。",
          "py": "Kuài dào dōngtiān le.",
          "vn": "Sắp đến mùa đông rồi."
        }
      ],
      "tip": "Cũng nói 要…了 / 快要…了.  火车快到了 = tàu sắp đến rồi.",
      "audio": "assets/audio/slide09.mp3"
    },
    {
      "type": "grammar",
      "kicker": "语法",
      "title": "过",
      "image": "assets/travel.jpg",
      "image_side": "left",
      "point": "动词 + 过 = ĐÃ TỪNG (có kinh nghiệm, không cần biết khi nào).",
      "examples": [
        {
          "hz": "我去过北京。",
          "py": "Wǒ qù guo Běijīng.",
          "vn": "Mình từng đến Bắc Kinh."
        },
        {
          "hz": "你看过雪吗？",
          "py": "Nǐ kàn guo xuě ma?",
          "vn": "Bạn từng thấy tuyết chưa?"
        }
      ],
      "note": "Phủ định: 没…过 — 我没去过。(Mình chưa từng đi.)",
      "tip": "过 nhấn 'đã trải qua ít nhất 1 lần'.  了 nhấn 'việc lần này đã xong'.",
      "audio": "assets/audio/slide10.mp3"
    },
