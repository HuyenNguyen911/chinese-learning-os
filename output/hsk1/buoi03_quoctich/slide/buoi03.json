    {
      "type": "grammar",
      "kicker": "语法",
      "title": "是 — nói mình là người nước nào",
      "image": "assets/icons/icon_id.png",
      "point": "是 nối 2 phần để nói AI ĐÓ LÀ GÌ/AI. Nói quốc tịch: [Ai] + 是 + [nước] + 人. Phủ định thêm 不 ngay TRƯỚC 是.",
      "examples": [
        {
          "hz": "我是法国人。",
          "py": "Wǒ shì Fǎguó rén.",
          "vn": "Tôi là người Pháp."
        },
        {
          "hz": "她是中文老师。",
          "py": "Tā shì Zhōngwén lǎoshī.",
          "vn": "Cô ấy là giáo viên tiếng Trung."
        },
        {
          "hz": "我老师不是法国人。",
          "py": "Wǒ lǎoshī bú shì Fǎguó rén.",
          "vn": "Giáo viên của tôi không phải người Pháp."
        }
      ],
      "note": "3 câu trên lấy nguyên từ sách. Nhớ luôn có 人 sau tên nước — thiếu 人 là sai.",
      "tip": "我是中国 ❌ — phải nói 我是中国人 ✅ (thiếu 人 là câu sai, không phải 'tôi là Trung Quốc' như tiếng Việt hay nói tắt).",
      "audio": "assets/audio/slide23.mp3"
    },
    {
      "type": "grammar",
      "kicker": "语法",
      "title": "的 — nói CỦA AI (sở hữu)",
      "image": "assets/icons/icon_link.png",
      "point": "的 nghĩa là \"CỦA\". Đặt giữa: [người] + 的 + [đồ vật/người khác]. Nếu trước 的 là TÔI/BẠN và sau 的 là người thân/thầy cô/bạn học thì được BỎ 的.",
      "examples": [
        {
          "hz": "你的名字",
          "py": "nǐ de míngzi",
          "vn": "tên của bạn"
