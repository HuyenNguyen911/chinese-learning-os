    {
      "type": "grammar",
      "kicker": "语法",
      "title": "个 · 口",
      "image": "assets/gekou.jpg",
      "image_side": "left",
      "point": [
        "个 (gè) = lượng từ vạn năng — dùng khi chưa chắc.",
        "口 (kǒu) = đếm người trong GIA ĐÌNH."
      ],
      "examples": [
        {
          "hz": "一个老师，两个学生。",
          "py": "yí gè lǎoshī, liǎng gè xuéshēng.",
          "vn": "một giáo viên, hai học sinh."
        },
        {
          "hz": "我家有五口人。",
          "py": "Wǒ jiā yǒu wǔ kǒu rén.",
          "vn": "Nhà mình có 5 người."
        }
      ],
      "note": "Chú ý: 二 → 两 khi đứng trước lượng từ (两个, không nói 二个).",
      "tip": "Chưa chắc dùng lượng từ nào? Cứ dùng 个. Nhưng hỏi số người trong nhà thì luôn 口.",
      "audio": "assets/audio/slide07.mp3"
    },
    {
      "type": "grammar",
      "kicker": "语法",
      "title": "件 · 张",
