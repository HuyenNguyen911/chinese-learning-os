  "blocks": [
    {
      "type": "grammar_note",
      "title": "Định dạng đề thi HSKK sơ cấp",
      "points": [
        {
          "pattern": "1. Lặp lại sau khi nghe",
          "explain": "15 câu hỏi, 4 phút"
        },
        {
          "pattern": "2. Trả lời sau khi nghe",
          "explain": "10 câu hỏi, 3 phút"
        },
        {
          "pattern": "3. Trả lời câu hỏi",
          "explain": "2 câu hỏi, 3 phút"
        },
        {
          "pattern": "Tổng thời gian làm bài",
          "explain": "khoảng 17 phút (bao gồm 7 phút chuẩn bị)."
        },
        {
          "pattern": "Trình độ Sơ cấp",
          "explain": "học viên sẽ nắm được khoảng 200 từ tiếng Trung thường dùng trong đàm thoại hàng ngày."
        },
        {
          "pattern": "HSKK (Thi Nói HSK) Sơ cấp",
          "explain": "áp dụng cho học viên đã qua HSK1 và HSK2."
        }
      ]
    },
