{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)"
    ],
    "allow": [
      "Bash(cd *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(pandoc *)",
      "Bash(git config --global user.name)",
      "Bash(git config --global user.email)"
    ]
  }
}
